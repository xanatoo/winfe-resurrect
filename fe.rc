#include "fe.h"
#include <owlrc.h>
#include "stdwnds.dlg"

#include "..\pcaide\pcaide.rc"

COMMANDS_ACC ACCELERATORS 
BEGIN
	"^X", CM_EDITCUT
	"^C", CM_EDITCOPY
	"^V", CM_EDITPASTE
	VK_DELETE, CM_EDITDELETE, VIRTKEY
	VK_DELETE, CM_EDITCLEAR, VIRTKEY, CONTROL
	"Z", CM_EDITUNDO, VIRTKEY, CONTROL
	"F", CM_EDITFIND, VIRTKEY, CONTROL
	"^G", CM_EDITFINDNEXT
	"^R", CM_EDITREPLACE, ASCII
END

COMMANDS MENU 
BEGIN
	POPUP "&Document"
	BEGIN
		MENUITEM "&Grab", CM_GRAB
		MENUITEM "&Release", CM_RELEASE
		MENUITEM "&New variant", CM_NEWVARIANT
		MENUITEM SEPARATOR
		MENUITEM "&Info", CM_INFO
		POPUP "&Links"
		BEGIN
			MENUITEM "&Links", CM_LINKS
			MENUITEM "&Start Link", CM_STARTLINK
			MENUITEM "End &Link", CM_ENDLINK
			MENUITEM "&Attachment", CM_ATTACHMENT
		END

		MENUITEM "D&elete", CM_DELETE
		MENUITEM SEPARATOR
		MENUITEM "Save All", CM_SAVE
		MENUITEM "Return &Home", CM_RETURNHOME
		MENUITEM "Initiali&ze", CM_INITIALIZE
		MENUITEM "Test Clubs", CM_TESTCLUBS
		MENUITEM "E&xit", CM_EXIT
	END

	POPUP "&Edit"
	BEGIN
		MENUITEM "&Undo\aCtrl+Z", CM_EDITUNDO
		MENUITEM SEPARATOR
		MENUITEM "&Cut\aCtrl+X", CM_EDITCUT
		MENUITEM "C&opy\aCtrl+C", CM_EDITCOPY
		MENUITEM "&Paste\aCtrl+V", CM_EDITPASTE
		MENUITEM "&Delete\aDel", CM_EDITDELETE
		MENUITEM SEPARATOR
		MENUITEM "Insert file...", CM_INSERTFILE
		MENUITEM "Copy to file...", CM_COPYTOFILE
		MENUITEM SEPARATOR
		MENUITEM "&Find...\aCtrl+F", CM_EDITFIND
		MENUITEM "&Replace...\aCtrl+R", CM_EDITREPLACE
		MENUITEM "&Next\aCtrl+G", CM_EDITFINDNEXT
	END

	POPUP "&Window"
	BEGIN
		MENUITEM "&Cascade", CM_CASCADECHILDREN
		MENUITEM "&Tile", CM_TILECHILDREN
		MENUITEM "Arrange &Icons", CM_ARRANGEICONS
		MENUITEM "C&lose All", CM_CLOSECHILDREN
	END

END

ID_LINKINFO DIALOG 18, -43, 164, 123
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Link info"
BEGIN
	CONTROL "Owner:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 10, 7, 61, 8
	CONTROL "Read permission:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 10, 38, 61, 8
	CONTROL "Edit permission:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 10, 54, 61, 8
	LTEXT "Text", ID_OWNER, 80, 7, 67, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
	CONTROL "Private", ID_READPERM, "COMBOBOX", CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 79, 36, 72, 33
	CONTROL "Private", ID_EDITPERM, "COMBOBOX", CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 79, 52, 72, 33
	DEFPUSHBUTTON "&OK", IDOK, 82, 101, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "&Cancel", IDCANCEL, 124, 101, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	CONTROL "Last revision by:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 10, 70, 61, 8
	CONTROL "Current editor:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 10, 85, 61, 8
	LTEXT "Text", ID_LASTREVISIONBY, 80, 70, 67, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
	LTEXT "Text", ID_CURRENTEDITOR, 80, 85, 67, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
	CONTROL "Title:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 10, 22, 61, 8
	EDITTEXT ID_TITLE, 79, 20, 72, 12, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
END



ID_LOGIN DIALOG 12, 20, 164, 71
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Login Please"
FONT 10, "System"
BEGIN
	CONTROL "Login name:", 205, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 9, 28, 41, 10
	CONTROL "System Admin", ID_LOGINNAME, "EDIT", ES_LEFT | ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 54, 26, 100, 12
	DEFPUSHBUTTON "&OK", IDOK, 79, 47, 32, 14
	PUSHBUTTON "&Cancel", IDCANCEL, 121, 47, 32, 14
	CONTROL "Host info:", 205, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 9, 10, 35, 10
	CONTROL "socket vlad 65002", ID_HOSTNAME, "EDIT", ES_LEFT | ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 54, 8, 100, 12
END


ID_DOCINFO DIALOG -34, -44, 217, 159
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Document info for "
BEGIN
	EDITTEXT ID_TITLE, 30, 7, 179, 12, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP | WS_TABSTOP
	LTEXT "Text", ID_OWNER, 116, 25, 57, 8, WS_CHILD | WS_VISIBLE
	CONTROL "Private", ID_READPERM, "COMBOBOX", CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 108, 51, 75, 60
	CONTROL "Private", ID_EDITPERM, "COMBOBOX", CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 108, 67, 75, 60
	CONTROL "None", ID_RECORDHISTORY, "COMBOBOX", CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 108, 83, 75, 60
	CONTROL "&OK", IDOK, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 124, 134, 32, 14
	CONTROL "&Cancel", IDCANCEL, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 171, 134, 32, 14
	CONTROL "Owner:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 84, 25, 25, 8
	CONTROL "Read permission:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 36, 53, 64, 8
	CONTROL "Edit permission:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 36, 69, 64, 8
	CONTROL "Last revision by:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 3, 116, 61, 8
	CONTROL "Current editor:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 114, 116, 47, 8
	LTEXT "Text", ID_LASTREVISIONBY, 68, 116, 43, 8, WS_CHILD | WS_VISIBLE
	LTEXT "Text", ID_CURRENTEDITOR, 165, 116, 51, 8, WS_CHILD | WS_VISIBLE
	CONTROL "Title:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 6, 9, 18, 8
	CONTROL "History recording:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 36, 84, 64, 8
	CONTROL "", 116, "BorShade", 2 | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 41, 42, 141, 3
	CONTROL "", 116, "BorShade", 2 | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 41, 106, 141, 3
END

#include "filedial.dlg"

FDLG_RATE DIALOG 18, 18, 180, 123
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ACME Rate Request"
FONT 8, "MS Sans Serif"
BEGIN
	RTEXT "Name:", -1, 12, 13, 44, 8, SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP
	RTEXT "Underwriter:", -1, 12, 32, 44, 8, SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP
	RTEXT "Instructions:", -1, 12, 51, 44, 8, SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP
	EDITTEXT FI_RATE_NAME, 62, 11, 99, 12, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
	EDITTEXT FI_RATE_UNDERWRITER, 62, 30, 99, 12, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
	CONTROL "", FI_RATE_INSTRUCTIONS, "EDIT", ES_LEFT | ES_MULTILINE | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 62, 49, 99, 46
	CONTROL "Sample Checkbox", FI_RATE_SAMPLECHECKBOX, "BUTTON", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 49, 103, 80, 12
END


FDLG_MEMO DIALOG 18, 18, 187, 135
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Memo"
FONT 8, "MS Sans Serif"
BEGIN
	RTEXT "To:", -1, 10, 10, 44, 8, SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP
	RTEXT "From:", -1, 10, 29, 44, 8, SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP
	RTEXT "Re:", -1, 10, 48, 44, 8, SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP
	EDITTEXT FI_MEMO_TO, 60, 8, 99, 12, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
	EDITTEXT FI_MEMO_FROM, 60, 27, 99, 12, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
	EDITTEXT FI_MEMO_RE, 60, 46, 99, 13, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
	LTEXT "Message:", -1, 22, 69, 33, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
	CONTROL "", FI_MEMO_MESSAGE, "EDIT", ES_LEFT | ES_MULTILINE | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 60, 67, 99, 36
	PUSHBUTTON "Reference", FI_MEMO_REFERENCE, 66, 112, 46, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
END

